{
  "name": "markov-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preprocess:frame-index": "node src/preprocess/runFrameIndex.js",
    "preprocess:trajectory-features": "node src/preprocess/runTrajectoryFeatures.js",
