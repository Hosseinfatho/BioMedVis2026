    "preprocess:structural-index": "node src/preprocess/runStructuralIndex.js",
    "preprocess:state-summaries": "node --max-old-space-size=8192 src/preprocess/runStateSummaries.js",
    "preprocess:representative-frames": "node --max-old-space-size=8192 src/preprocess/runRepresentativeFrames.js",
    "preprocess:state-trajectory-frame-counts": "node --max-old-space-size=8192 src/preprocess/runStateTrajectoryFrameCounts.js",
    "preprocess:signature-residuals": "node --max-old-space-size=8192 src/preprocess/runSignatureResiduals.js",
    "preprocess:state-driver-interactions": "node --max-old-space-size=8192 src/preprocess/runStateDriverInteractions.js"
  },
  "dependencies": {
    "3dmol": "^2.5.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.1"
