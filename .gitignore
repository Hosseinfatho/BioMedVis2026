# --- GitHub Pages: curated public/data only (~50 MB) ---

# Block everything under public/data, then allow UI subsets
public/data/**
!public/data/zsab2/
!public/data/zsab3/
!public/data/zsab4/
!public/data/Residual/

# Challenge text files (6 per system)
public/data/zsab2/*
!public/data/zsab2/*.txt
public/data/zsab3/*
!public/data/zsab3/*.txt
public/data/zsab4/*
!public/data/zsab4/*.txt

# Preprocess outputs used by the dashboard (~41 MB)
public/data/Residual/*
!public/data/Residual/state_signature_residuals.json
!public/data/Residual/state_driver_interactions.json
!public/data/Residual/state_trajectory_frame_counts.json
